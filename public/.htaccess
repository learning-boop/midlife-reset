# Apache, which is what cPanel runs.
#
# The site is one React app behind one index.html, so the server has to answer
# an address like /fees with that file and let the router decide what renders.
# Without this, Apache looks for a folder called "fees", finds none, and
# returns 404 before the app ever starts — so every page except the home page
# breaks on a direct visit or a refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Anyone who types the bare domain arrives over plain http. Send them to
  # https permanently, before anything else is decided, so no page and no
  # asset is ever served unencrypted.
  #
  # Two conditions, not one: on shared hosting the TLS is often terminated by
  # a proxy in front of Apache, which leaves %{HTTPS} off on a request that
  # already arrived securely. X-Forwarded-Proto is what that proxy sets, and
  # checking it as well is what stops the rule redirecting to itself forever.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # A real file or folder is served as itself: the JavaScript, the CSS, the
  # photographs, robots.txt. Only addresses with nothing behind them fall
  # through to the app.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule . /index.html [L]
</IfModule>

# Vite puts a content hash in every asset filename, so a changed file is a new
# name and an unchanged one can be held for a year. index.html must never be
# cached, or a visitor keeps being handed the old app after an upload.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
